# Makefile for the lysis fibrinolysis model.
#
# Builds the compiled artifacts the Python package shells out to or loads:
#   - Fortran micro/macro simulation binaries -> ./bin
#   - the KISS RNG shared library             -> ./lib/kiss.so
#                                                (loaded by lysis.tools.kiss)
#
# Common targets (run `make help` for the list):
#   make            build everything (Fortran binaries + kiss.so)
#   make fort       build only the Fortran binaries
#   make shared     build only lib/kiss.so
#   make clean      remove ./bin and ./lib
#   make clobber    clean + remove the generated version_stamp.f90
#   make configure LYSIS_COMPILER=<name>   save a default Fortran compiler
#   make unconfigure                       forget the saved compiler
#
# Fortran compiler: one of ifx (the default), ifort or gfortran, chosen
# with LYSIS_COMPILER and never by editing this file:
#   make LYSIS_COMPILER=gfortran              this build only
#   make configure LYSIS_COMPILER=gfortran    saved in ./config.mk (untracked);
#                                             later plain `make` runs use it
# A value on the command line beats the saved one, which beats the default.
# LYSIS_COMPILER in the environment is ignored (with a warning), so an
# exported variable cannot pick a compiler nobody asked for.  Changing the
# compiler, its flags or its version rebuilds every Fortran binary.
#
# gfortran builds every binary, but `lysis run-macro` cannot yet drive the
# gfortran macroscale binaries: one staged input file is rejected (#140).
#
# Requirements: the chosen compiler on PATH.  On the cluster,
# `module load intel-compilers/2024.2.0` provides ifx and ifort, and
# `module load GCC/12.3.0` the gfortran version this was checked with.
# `shared` needs only gcc.
# Neither ./bin nor ./lib is tracked in git -- both are created on demand.

# Environment
MKDIR = mkdir

# ---------------------------------------------------------------------------
# Fortran compiler selection
# ---------------------------------------------------------------------------
# Each choice carries a complete flag set with the same semantics:
# 8-byte default REAL and DOUBLE PRECISION, no line-length limit, traps on
# invalid/divide-by-zero/overflow, -O2, medium memory model, backtraces.
# The Intel lines are unchanged from the ifort-only Makefile (-O2 is the
# Intel default); gfortran needs each setting spelled out.  The variable is
# deliberately not FC: GNU make predefines FC (f77) and toolchain modules
# commonly export it.
LYSIS_COMPILERS := ifx ifort gfortran
LYSIS_COMPILER_DEFAULT := ifx
FORT_ifx      = ifx -r8 -mcmodel medium -traceback -fpe0
FORT_ifort    = ifort -r8 -mcmodel medium -traceback -fpe0 -diag-disable=10448
FORT_gfortran = gfortran -O2 -fdefault-real-8 -fdefault-double-8 \
                -ffree-line-length-none -ffpe-trap=invalid,zero,overflow \
                -mcmodel=medium -fbacktrace
# Shown when the chosen compiler is not on PATH.
FORT_HINT_ifx      = on the cluster: module load intel-compilers/2024.2.0
FORT_HINT_ifort    = on the cluster: module load intel-compilers/2024.2.0 (or 2023.1.0)
FORT_HINT_gfortran = install gfortran, or load a GCC module

# Saved choice, written by `make configure`.  Untracked (see .gitignore).
CONFIG_MK = config.mk
-include $(CONFIG_MK)

ifeq ($(origin LYSIS_COMPILER),environment)
  $(warning LYSIS_COMPILER=$(LYSIS_COMPILER) in the environment is ignored; pass it on the make command line or use `make configure`)
endif
ifeq ($(origin LYSIS_COMPILER),command line)
  LYSIS_COMPILER_SOURCE := command line
else ifneq ($(strip $(LYSIS_SAVED_COMPILER)),)
  override LYSIS_COMPILER := $(strip $(LYSIS_SAVED_COMPILER))
  LYSIS_COMPILER_SOURCE := saved in $(CONFIG_MK) by make configure
else
  override LYSIS_COMPILER := $(LYSIS_COMPILER_DEFAULT)
  LYSIS_COMPILER_SOURCE := default
endif

# Reject unknown values for every goal that might compile Fortran.  help,
# clean, clobber and unconfigure still work, so a bad saved value can be
# inspected and removed.
LYSIS_NO_COMPILER_GOALS := help clean clobber unconfigure
ifneq ($(filter-out $(LYSIS_NO_COMPILER_GOALS),$(or $(MAKECMDGOALS),build)),)
  ifneq ($(words $(LYSIS_COMPILER))$(filter $(LYSIS_COMPILER),$(LYSIS_COMPILERS)),1$(strip $(LYSIS_COMPILER)))
    $(error Unknown LYSIS_COMPILER '$(LYSIS_COMPILER)' ($(LYSIS_COMPILER_SOURCE)); valid values: $(LYSIS_COMPILERS))
  endif
endif

FORT = $(FORT_$(LYSIS_COMPILER))
FORT_EXE = $(firstword $(FORT))
C = gcc -std=c99

BUILD_DIR = ./bin
LIB_DIR = ./lib
C_SRC_DIR = ./src/c
FORT_SRC_DIR = ./src/fortran
# Generated by the recipe below; gitignored.  Baked into every live
# Fortran binary so it can self-report which commit it was built from.
VERSION_F90 = $(FORT_SRC_DIR)/version_stamp.f90
# Records the Fortran compile command and the compiler's version line.
# Every Fortran binary depends on it, so a change of compiler rebuilds them.
# Lives in ./bin (untracked), so it never touches the version stamp's
# clean/dirty state, which looks only at src/fortran/.
COMPILER_STAMP = $(BUILD_DIR)/.fortran-compiler
FORT_MACRO = macro_diffuse_into_and_along__internal \
             macro_diffuse_into_and_along__external

.PHONY: build all fort fort-micro fort-macro shared clean clobber help \
        configure unconfigure

# Default target: build all compiled artifacts.
build: fort shared

all: build

fort: fort-micro fort-macro

fort-micro: $(BUILD_DIR)/micro_rates # $(BUILD_DIR)/micro_wrapped

fort-macro: $(foreach file,$(FORT_MACRO),$(BUILD_DIR)/$(file))

shared: $(LIB_DIR)/kiss.so

# version_stamp.f90 is a tiny Fortran module holding BUILD_TAG,
# BUILD_COMMIT and BUILD_DIRTY string parameters resolved from git.  Each
# live Fortran binary `use`s it -- together with the Fortran-2008 intrinsic
# `compiler_version()` from iso_fortran_env -- and supports `--version`,
# which prints "<tag> <commit> <clean|dirty> <compiler-string>" so the
# Python wrapper can confirm the binary was built from the currently-
# checked-out source AND the expected compiler before launching a
# simulation.  The compiler info is contributed by the compiler itself at
# compile time, so no Makefile probing is needed for it.
#
# BUILD_TAG is the nearest release tag reachable from HEAD
# (`git describe --tags --abbrev=0`, e.g. "v0.3.0"); it is a human-facing
# release label only and is not used by the staleness check.  BUILD_COMMIT
# is the most recent commit *that touched src/fortran/*, not the repo HEAD.
# This way commits that change only Python/docs/etc do not flag the binary
# as stale -- only commits that actually modify the Fortran source do.
# BUILD_DIRTY is scoped the same way: tracked uncommitted changes under
# src/fortran/ flip it to "dirty".
#
# The recipe runs on every `make` (via the FORCE prerequisite below) so
# it always reflects current state, but writes via a tmp+cmp+mv pattern:
# the file's mtime only bumps when the embedded stamp actually changes,
# letting Make's normal mtime-based dependency resolution skip recompiles
# when nothing has changed.
$(VERSION_F90): FORCE
	@if git rev-parse HEAD >/dev/null 2>&1; then \
	    COMMIT=$$(git log -1 --format=%H HEAD -- $(FORT_SRC_DIR) 2>/dev/null); \
	    [ -n "$$COMMIT" ] || COMMIT=unknown; \
	    TAG=$$(git describe --tags --abbrev=0 2>/dev/null); \
	    [ -n "$$TAG" ] || TAG=unknown; \
	    if git diff --quiet HEAD -- $(FORT_SRC_DIR) 2>/dev/null; then DIRTY=clean; else DIRTY=dirty; fi; \
	else \
	    TAG=unknown; COMMIT=unknown; DIRTY=unknown; \
	fi; \
	printf 'module version_stamp\n  implicit none\n  character(len=*), parameter :: BUILD_TAG    = "%s"\n  character(len=*), parameter :: BUILD_COMMIT = "%s"\n  character(len=*), parameter :: BUILD_DIRTY  = "%s"\nend module version_stamp\n' \
	    "$$TAG" "$$COMMIT" "$$DIRTY" > $@.tmp; \
	if cmp -s $@.tmp $@ 2>/dev/null; then \
	    rm $@.tmp; \
	else \
	    mv $@.tmp $@; \
	fi

# Empty non-phony target: Make can never "find" it on disk, so it treats
# FORCE as always-newer-than-$(VERSION_F90) and re-fires that recipe on
# every build.  Marking $(VERSION_F90) itself .PHONY would also re-fire
# the recipe, but a .PHONY prerequisite is always considered out-of-date,
# which would cascade unconditional recompiles into every binary that
# depends on $(VERSION_F90).
FORCE:

# Rewritten on every build, but via tmp+cmp+mv like $(VERSION_F90), so its
# mtime only moves -- and the binaries only rebuild -- when the compile
# command or the compiler's own version line changes.  Also the place a
# missing compiler is reported, with a hint for loading it.  The first
# line it prints names the compiler, which is what
# lysis.tools.provenance.binary._identify_compiler_binary reads from a
# historical build's log.
$(COMPILER_STAMP): FORCE | $(BUILD_DIR)
	@echo "Fortran compiler: $(LYSIS_COMPILER) ($(LYSIS_COMPILER_SOURCE))"
	@VER=$$($(FORT_EXE) --version 2>/dev/null | head -n 1); \
	if [ -z "$$VER" ]; then \
	    echo "error: Fortran compiler '$(FORT_EXE)' not found on PATH ($(FORT_HINT_$(LYSIS_COMPILER)))." >&2; \
	    echo "       Or choose another: make LYSIS_COMPILER=<$(subst $(eval) ,|,$(LYSIS_COMPILERS))>" >&2; \
	    exit 1; \
	fi; \
	printf '%s\n%s\n' '$(FORT)' "$$VER" > $@.tmp; \
	if cmp -s $@.tmp $@ 2>/dev/null; then \
	    rm $@.tmp; \
	else \
	    mv $@.tmp $@; \
	fi

# $(VERSION_F90) is passed BEFORE the program source on the compile line
# so its .mod file is produced first within a single compiler invocation,
# making the `use version_stamp` in the program resolvable.
$(BUILD_DIR)/micro_rates: $(FORT_SRC_DIR)/micro_rates.f90 $(VERSION_F90) $(BUILD_DIR)/kiss.o $(COMPILER_STAMP) | $(BUILD_DIR)
	$(FORT) $(BUILD_DIR)/kiss.o $(VERSION_F90) $(FORT_SRC_DIR)/micro_rates.f90 -o $(BUILD_DIR)/micro_rates

# $(BUILD_DIR)/micro_wrapped: $(FORT_SRC_DIR)/micro_wrapped.f90 $(BUILD_DIR)/kiss.o
# 	$(FORT) $(BUILD_DIR)/kiss.o $(FORT_SRC_DIR)/micro_wrapped.f90 -o $(BUILD_DIR)/micro_wrapped

$(BUILD_DIR)/macro_diffuse_into_and_along__external: $(FORT_SRC_DIR)/macro_diffuse_into_and_along__external.f90 $(VERSION_F90) $(BUILD_DIR)/kiss.o $(COMPILER_STAMP) | $(BUILD_DIR)
	$(FORT) $(BUILD_DIR)/kiss.o $(VERSION_F90) $(FORT_SRC_DIR)/macro_diffuse_into_and_along__external.f90 -o $(BUILD_DIR)/macro_diffuse_into_and_along__external

$(BUILD_DIR)/macro_diffuse_into_and_along__internal: $(FORT_SRC_DIR)/macro_diffuse_into_and_along__internal.f90 $(VERSION_F90) $(BUILD_DIR)/kiss.o $(COMPILER_STAMP) | $(BUILD_DIR)
	$(FORT) $(BUILD_DIR)/kiss.o $(VERSION_F90) $(FORT_SRC_DIR)/macro_diffuse_into_and_along__internal.f90 -o $(BUILD_DIR)/macro_diffuse_into_and_along__internal

$(LIB_DIR)/kiss.so: $(C_SRC_DIR)/kiss.c | $(LIB_DIR)
	$(C) -fPIC -shared -o $(LIB_DIR)/kiss.so $(C_SRC_DIR)/kiss.c

$(BUILD_DIR)/kiss.o: $(C_SRC_DIR)/kiss.c | $(BUILD_DIR)
	$(C) -c $(C_SRC_DIR)/kiss.c -o $(BUILD_DIR)/kiss.o
#	gcc -c -std=c99 $(C_SRC_DIR)/kiss.c -o $(BUILD_DIR)/kiss.o

# Output directories (order-only prerequisites): created on demand so a
# fresh checkout needs no manual `mkdir`.  Neither dir is tracked in git.
$(BUILD_DIR) $(LIB_DIR):
	$(MKDIR) -p $@

# Remove built artifacts.  Both dirs are recreated on demand by the next build.
# clean and clobber keep a compiler saved by `make configure`: it is a
# setting, not a build product.  `make unconfigure` removes it.
clean:
	rm -rf $(BUILD_DIR) $(LIB_DIR)

# clean plus the generated (gitignored) version stamp source.
clobber: clean
	rm -f $(VERSION_F90)

# Save a compiler choice for later plain `make` runs.  Needs the value on
# the command line; an unknown one is rejected by the check near the top.
configure:
ifneq ($(origin LYSIS_COMPILER),command line)
	@echo "usage: make configure LYSIS_COMPILER=<$(subst $(eval) ,|,$(LYSIS_COMPILERS))>" >&2; exit 1
else
	@printf '# Written by `make configure`; untracked.  Remove with `make unconfigure`.\nLYSIS_SAVED_COMPILER := %s\n' '$(LYSIS_COMPILER)' > $(CONFIG_MK)
	@echo "Saved LYSIS_COMPILER=$(LYSIS_COMPILER) in $(CONFIG_MK); plain \`make\` now uses it."
endif

unconfigure:
	rm -f $(CONFIG_MK)

help:
	@echo "Targets:"
	@echo "  build        (default) build Fortran binaries + lib/kiss.so"
	@echo "  fort         build only the Fortran binaries"
	@echo "  shared       build only lib/kiss.so (needs gcc)"
	@echo "  all          alias for build"
	@echo "  clean        remove ./bin and ./lib (keeps a saved compiler)"
	@echo "  clobber      clean + remove the generated version_stamp.f90"
	@echo "  configure    save LYSIS_COMPILER in $(CONFIG_MK) for later builds"
	@echo "  unconfigure  remove $(CONFIG_MK), returning to the default compiler"
	@echo ""
	@echo "Fortran compiler: $(LYSIS_COMPILER) ($(LYSIS_COMPILER_SOURCE))"
	@echo "  valid values:   $(LYSIS_COMPILERS) (default $(LYSIS_COMPILER_DEFAULT))"
	@echo "  this build:     make LYSIS_COMPILER=gfortran"
	@echo "  save a default: make configure LYSIS_COMPILER=gfortran"
	@echo "  command line beats saved beats default; the environment is ignored."
